TZ=Asia/Shanghai

# 本机 Docker 架构。当前机器是 arm64；如果放到常见 x86_64 VPS 上源码构建，改成 amd64。
TARGETOS=linux
TARGETARCH=arm64

API_PORT=8080
USER_PORT=8081
ADMIN_PORT=8082

# 仅首次初始化管理员时生效，数据库已有管理员后不会覆盖。
DJ_DEFAULT_ADMIN_USERNAME=admin
DJ_DEFAULT_ADMIN_PASSWORD=ChangeMe_Admin_123

# Redis 内网密码，需要与 config/config.yml 中 redis.password 和 queue.password 一致。
REDIS_PASSWORD=ab37483af87b55b1d737fc0190d8987c997d863bd63cd2e8
